# Copy this file to .env and fill in the values from your app in the
# Spotify Developer Dashboard (https://developer.spotify.com/dashboard).
# Never commit .env; it contains your client secret.

SPOTIFY_CLIENT_ID=XXXXXXXXXX
SPOTIFY_CLIENT_SECRET=XXXXXXXXX

# Must match a Redirect URI registered on your app *exactly*.
# Spotify requires a loopback IP (127.0.0.1), not "localhost".
SPOTIFY_REDIRECT_URI=XXXXXXXXXX

# Phase 2: BPM/key enrichment. Free key from https://getsongbpm.com/api
GETSONGBPM_API_KEY=your-getsongbpm-api-key

# Phase 3: mood/genre tags. Free key from https://www.last.fm/api/account/create
LASTFM_API_KEY=your-lastfm-api-key
